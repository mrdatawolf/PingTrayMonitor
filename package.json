{
  "name": "ping-tray-monitor",
  "version": "1.1.0",
  "description": "Unified system-tray monitor for connection and process status",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "build:web": "vite build --config vite.web.config.js",
    "build:demo": "vite build --config vite.demo.config.js",
    "demo": "npm run build:demo && node scripts/demo-server.js"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.0",
    "antd": "^5.22.0",
    "dotenv": "^17.4.2",
    "electron-squirrel-startup": "^1.0.1",
    "mqtt": "^5.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.0.0",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.0.0",
    "@electron-forge/plugin-fuses": "^7.0.0",
    "@electron-forge/plugin-vite": "^7.0.0",
    "@electron/fuses": "^1.8.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^34.0.0",
    "vite": "^6.0.0"
  }
}
